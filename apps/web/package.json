{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mint-token": "node --conditions=react-server --env-file-if-exists=.env.local scripts/mint-token.ts",
    "rebuild-ratings": "node --env-file-if-exists=.env.local --import tsx scripts/rebuild-ratings.ts",
    "copy-raw-stats": "node --env-file-if-exists=.env.local --import tsx scripts/copy-raw-stats.ts",
    "set-premium": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/set-premium.ts",
    "m7-13-battle-test": "node --import tsx scripts/m7-13-battle-test.ts",
    "ddragon-fixture": "node --import tsx scripts/ddragon-fixture.ts",
    "seed-regions": "node --import tsx scripts/seed-regions.ts",
    "ai-eval": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-eval.ts",
    "ai-eval-month": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-eval-month.ts",
    "font-subsets": "python3 scripts/font-subsets.py",
    "perf-tonight": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/perf-tonight.ts",
    "patch-notes-image": "TSX_TSCONFIG_PATH=scripts/patch-notes/tsconfig.json node --conditions=react-server --import tsx scripts/patch-notes-image.tsx",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@customs/core": "workspace:*",
    "@customs/db": "workspace:*",
    "@supabase/realtime-js": "2.115.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.115.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.4",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
