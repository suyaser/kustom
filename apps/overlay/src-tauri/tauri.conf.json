{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kustom Overlay",
  "version": "0.1.0",
  "identifier": "night.customs.overlay",
  "build": {
    "frontendDist": "../dist/ui",
    "devUrl": "about:blank",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kustom Overlay",
        "width": 420,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": false,
        "visible": true,
        "center": false,
        "url": "about:blank"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png"
    ]
  }
}
