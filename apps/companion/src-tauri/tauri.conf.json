{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kustom",
  "version": "0.1.5",
  "identifier": "night.customs.kustom",
  "build": {
    "frontendDist": "../desktop/dist",
    "beforeDevCommand": "pnpm desktop:sync",
    "beforeBuildCommand": "pnpm desktop:sync"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kustom",
        "width": 480,
        "height": 620,
        "resizable": false,
        "center": true,
        "decorations": true,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "Kustom",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../dist/kustom-engine.exe": "kustom-engine.exe"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
