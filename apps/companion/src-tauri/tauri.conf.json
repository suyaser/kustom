{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kustom",
  "version": "1.0.2",
  "identifier": "night.customs.kustom",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kustom",
        "width": 400,
        "height": 690,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "center": true,
        "decorations": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#05070C"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBMjg3NzJFMUI0RUYyMEYKUldRUDhrNGJMbmNvK2o3V045b2JzbDNwL2lTQ1pLQmNZMVoyV1M4ZTg4bmI5Slk4V01Cb3BZWDgK",
      "endpoints": ["https://github.com/suyaser/kustom-releases/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
