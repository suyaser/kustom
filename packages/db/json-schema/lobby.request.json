{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customs-night/companion/lobby.request",
  "title": "companionLobbyPayloadSchema",
  "description": "POST /api/companion/lobby (request)",
  "type": "object",
  "properties": {
    "partyId": {
      "type": "string",
      "minLength": 1,
      "x-zod-not-exported": [
        "normalised"
      ]
    },
    "lobbyName": {
      "type": [
        "string",
        "null"
      ]
    },
    "lobbyPassword": {
      "type": [
        "string",
        "null"
      ]
    },
    "members": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "puuid": {
            "type": "string",
            "minLength": 1,
            "x-zod-not-exported": [
              "refine"
            ]
          },
          "summonerId": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "x-zod-not-exported": [
                      "refine"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d*$",
                    "x-zod-not-exported": [
                      "normalised"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "gameName": {
            "type": [
              "string",
              "null"
            ]
          },
          "tagLine": {
            "type": [
              "string",
              "null"
            ]
          },
          "side": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 100
                  },
                  {
                    "type": "number",
                    "const": 200
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "isSpectator": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "puuid"
        ]
      }
    },
    "droppedMembers": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "partyId",
    "members"
  ],
  "x-zod-not-exported": [
    "preprocess"
  ]
}
