{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customs-night/companion/commands-poll.payload.invite",
  "title": "inviteCommandPayloadSchema",
  "description": "GET /api/companion/commands (response). commands[].payload when kind is invite.",
  "type": "object",
  "properties": {
    "puuid": {
      "type": "string",
      "minLength": 1,
      "x-zod-not-exported": [
        "refine"
      ]
    },
    "summonerId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "puuid",
    "summonerId"
  ]
}
