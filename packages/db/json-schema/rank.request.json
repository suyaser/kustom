{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customs-night/companion/rank.request",
  "title": "companionRankPayloadSchema",
  "description": "POST /api/companion/rank (request)",
  "type": "object",
  "properties": {
    "puuid": {
      "type": "string",
      "minLength": 1,
      "x-zod-not-exported": [
        "refine"
      ]
    },
    "tier": {
      "type": [
        "string",
        "null"
      ]
    },
    "division": {
      "type": [
        "string",
        "null"
      ]
    },
    "lp": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "queue": {
      "default": "RANKED_SOLO_5x5",
      "type": "string",
      "minLength": 1
    },
    "gameName": {
      "type": [
        "string",
        "null"
      ]
    },
    "tagLine": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "puuid"
  ]
}
