{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customs-night/companion/game.response",
  "title": "companionGameResponseSchema",
  "description": "POST /api/companion/game (response)",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "phase": {
      "type": "string",
      "enum": [
        "in_progress",
        "eog"
      ]
    },
    "created": {
      "type": "boolean"
    },
    "gameId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lobbyId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "participants": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rated": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "skippedNotThisGroup": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "ok",
    "phase",
    "created",
    "gameId",
    "lobbyId",
    "participants"
  ]
}
