{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customs-night/companion/commands-poll.payload.create_lobby",
  "title": "createLobbyCommandPayloadSchema",
  "description": "GET /api/companion/commands (response). commands[].payload when kind is create_lobby. The poll itself types payload as any object.",
  "type": "object",
  "properties": {
    "lobbyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "x-zod-not-exported": [
        "normalised"
      ]
    },
    "lobbyPassword": {
      "type": "string",
      "minLength": 4,
      "maxLength": 16
    },
    "pickType": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "blind"
      ]
    }
  },
  "required": [
    "lobbyName",
    "lobbyPassword"
  ]
}
