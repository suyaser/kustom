{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customs-night/companion/error.response",
  "title": "companionErrorResponseSchema",
  "description": "every /api/companion/* route (response). The { ok: false } half of every answer, whatever the status code.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": false
    },
    "error": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ]
      }
    }
  },
  "required": [
    "ok",
    "error"
  ]
}
