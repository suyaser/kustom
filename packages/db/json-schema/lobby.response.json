{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customs-night/companion/lobby.response",
  "title": "companionLobbyResponseSchema",
  "description": "POST /api/companion/lobby (response)",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "lobbyId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "balanced",
        "in_game",
        "dropped",
        "finished",
        "abandoned"
      ]
    },
    "created": {
      "type": "boolean"
    },
    "memberCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rosterFrozen": {
      "type": "boolean"
    },
    "recheckInMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "ranksNeeded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "ok",
    "lobbyId",
    "status",
    "created",
    "memberCount",
    "rosterFrozen",
    "recheckInMs",
    "ranksNeeded"
  ]
}
